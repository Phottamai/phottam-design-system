{
  "name": "@phottamai/ds-b2b",
  "version": "2.0.0",
  "description": "Pure UI primitives for Phottam B2B (buttons, form items, modals, search, navigation), ported from phottam-desktop",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tailwind"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind-preset": {
      "types": "./tailwind/preset.d.cts",
      "default": "./tailwind/preset.cjs"
    },
    "./tailwind.css": "./tailwind/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:css",
    "build:css": "tailwindcss -c tailwind.styles.config.ts -i src/styles/package.css -o dist/styles.css --minify && cp src/styles/fonts.css dist/fonts.css && cp -R src/styles/fonts dist/fonts",
    "clean": "rm -rf dist storybook-static",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "export:tar": "node ../scripts/export-tarball.mjs"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-icons": ">=4.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "country-flag-icons": "^1.6.4",
    "date-fns": "^4.1.0",
    "lottie-react": "^2.4.1",
    "react-phone-number-input": "^3.4.14",
    "react-tooltip": "^5.30.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "framer-motion": "^12.31.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "storybook": "10.6.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.2",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
